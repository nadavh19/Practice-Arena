generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskCategory {
  exercise
  scale
  chord
  song_chords
  riff
  solo
  rhythm
  technique
}

enum UserRole {
  user
  admin
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  nickname   String?
  instrument String
  level      String
  goals      String
  role       UserRole  @default(user)
  createdAt  DateTime  @default(now())

  sessions   Session[]
}

model Session {
  id            String        @id @default(uuid())
  userId        String
  mood          String
  availableTime Int
  goal          String?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id])
  tasks         SessionTask[]
  feedback      Feedback?
}

model Task {
  id           String        @id @default(uuid())
  name         String
  difficulty   String
  duration     Int
  category     TaskCategory
  description  String?
  instrument   String?       @default("guitar")
  key          String?
  bpm          Int?
  tab          String?
  chords       String?
  scale        String?
  songName     String?
  artistName   String?
  createdAt    DateTime      @default(now())

  sessionTasks SessionTask[]
}

model SessionTask {
  id        String   @id @default(uuid())
  sessionId String
  taskId    String
  completed Boolean  @default(false)

  session   Session  @relation(fields: [sessionId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])
}

model Feedback {
  id               String   @id @default(uuid())
  sessionId        String   @unique
  difficultyRating Int
  focusRating      Int

  session          Session  @relation(fields: [sessionId], references: [id])
}
